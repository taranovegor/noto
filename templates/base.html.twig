<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        <meta name="theme-color" content="#fefefe">
        <meta name="description" content="Personal task and project management">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Noto">
        <title>{% block title %}Noto{% endblock %}</title>
        <link rel="icon" href="/icon.svg" type="image/svg+xml">
        <link rel="apple-touch-icon" href="/icons/icon-180.png">
        <link rel="apple-touch-startup-image" href="/splash/splash-375x667.png" media="(device-width: 375px) and (device-height: 667px)">
        <link rel="apple-touch-startup-image" href="/splash/splash-375x812.png" media="(device-width: 375px) and (device-height: 812px)">
        <link rel="apple-touch-startup-image" href="/splash/splash-390x844.png" media="(device-width: 390px) and (device-height: 844px)">
        <link rel="apple-touch-startup-image" href="/splash/splash-430x932.png" media="(device-width: 430px) and (device-height: 932px)">
        <link rel="manifest" href="/manifest.webmanifest">
        <meta name="vapid-public-key" content="{{ bentools_webpush.server_key }}">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
