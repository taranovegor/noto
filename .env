# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.

DOCKER_COMPOSE_ENV=dev
VERSION=local

APP_VECTORIZER_MODEL=voyage-4

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:ChangeMe@db:5432/noto?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/ai-voyage-platform ###
VOYAGE_API_KEY=
###< symfony/ai-voyage-platform ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@amqp:5672/%2f/messages
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe
JWT_TOKEN_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
JWT_REFRESH_TOKEN_TTL=604800
###< gesdinet/jwt-refresh-token-bundle ###

###> league/flysystem-async-aws-s3 ###
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ID=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_BUCKET=
###< league/flysystem-async-aws-s3 ###

###> component-centrifugo ###
CENTRIFUGO_URL=http://centrifuge:8000/api
CENTRIFUGO_API_KEY=ChangeSecret
CENTRIFUGO_SECRET=ChangeApiKey

CENTRIFUGAL_DSN=centrifugal://null
###< component-centrifugo ###
